[Unit]
Description=capd packet capture daemon
After=network.target

[Service]
Type=notify
ExecStart=/usr/local/bin/capd

User=ubuntu
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

RuntimeDirectory=capd

WatchdogSec=10
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target